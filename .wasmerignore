# Wasmer package contents.
# The package builder honours .gitignore, which hides vendor/, public/build and
# storage/. Re-include what the app needs at runtime.
!/vendor
!/public/build
!/bootstrap/cache
!/storage

# Heavy or unnecessary files.
node_modules
.git
.agents
.claude
.pi
.opencode
.zed
tests
design.pen
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
